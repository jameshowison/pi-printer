#!/bin/bash
#
# brother-hl5170dn-pjl - CUPS filter for Brother HL-5170DN
#
# Prepends a PJL header to control toner save, resolution, duplex,
# media type, and paper source. Converts input (PDF, PostScript, PWG
# Raster) to PCL 5e (ljet4) via Ghostscript if needed.
#
# CUPS calls filters as:
#   filter job-id user title copies options [filename]
#
# Install to: /usr/lib/cups/filter/brother-hl5170dn-pjl
# Permissions: chmod 755
#
# Dependencies: ghostscript, cups-filters

set -euo pipefail

#---- Configuration ----------------------------------------------------
# Coerce common paper sizes to LOADED_PAPER so a job requesting (e.g.) A4
# prints on the actually-loaded Letter without the printer pausing for a
# tray mismatch. Content is rescaled to fit via Ghostscript's PDFFitPage.
# Envelopes pass through unchanged (they require manual loading anyway).
# Set LOADED_PAPER='' to disable coercion entirely. Override at the
# cupsd-environment level or by editing this default.
LOADED_PAPER="${LOADED_PAPER:-Letter}"

#---- CUPS arguments ---------------------------------------------------
JOB_ID="${1:-0}"
USER="${2:-unknown}"
TITLE="${3:-Untitled}"
COPIES="${4:-1}"
OPTIONS="${5:-}"
INPUT="${6:-}"   # empty = read stdin

#---- Logging ----------------------------------------------------------
log()  { echo "DEBUG: brother-hl5170dn-pjl: $*"   >&2; }
warn() { echo "WARNING: brother-hl5170dn-pjl: $*" >&2; }
err()  { echo "ERROR: brother-hl5170dn-pjl: $*"   >&2; exit 1; }

log "Job $JOB_ID from $USER: '$TITLE' copies=$COPIES"
log "Options: $OPTIONS"

#---- Parse CUPS options -----------------------------------------------
# Helper: extract value for a named option from $OPTIONS
get_opt() {
    local key="$1" default="$2"
    # Match key=value (case-insensitive key). Pure-shell to stay portable
    # across GNU grep (Linux) and BSD grep (macOS, no -P) and across
    # bash 3.2 (default macOS) and bash 4+.
    local key_lc pair k v
    key_lc=$(echo "$key" | tr '[:upper:]' '[:lower:]')
    for pair in $OPTIONS; do
        k="${pair%%=*}"
        v="${pair#*=}"
        if [ "$(echo "$k" | tr '[:upper:]' '[:lower:]')" = "$key_lc" ]; then
            echo "$v"
            return
        fi
    done
    echo "$default"
}

RESOLUTION=$(get_opt "Resolution" "600dpi")
TONER_SAVE=$(get_opt "TonerSave" "OFF")
DUPLEX=$(get_opt "Duplex" "None")
MEDIA_TYPE=$(get_opt "MediaType" "PLAIN")
INPUT_SLOT=$(get_opt "InputSlot" "AUTO")
PAGE_SIZE=$(get_opt "PageSize" "Letter")

# Also check IPP standard attributes and map them
SIDES=$(get_opt "sides" "")
PRINT_QUALITY=$(get_opt "print-quality" "")
CUPS_PRINT_QUALITY=$(get_opt "cupsPrintQuality" "")

# Map IPP sides → Duplex
if [ -n "$SIDES" ]; then
    case "$SIDES" in
        two-sided-long-edge)  DUPLEX="DuplexNoTumble" ;;
        two-sided-short-edge) DUPLEX="DuplexTumble"   ;;
        one-sided)            DUPLEX="None"            ;;
    esac
fi

# Normalize print quality from either source into a single symbolic value.
#   cupsPrintQuality (PPD-driven, PickOne string) — set by the print dialog
#     when the user picks Draft/Normal/High in the Mac options panel
#   print-quality (IPP enum) — set by AirPrint clients (iOS, IPP Everywhere)
# cupsPrintQuality wins if both are present (PPD option > raw IPP attribute).
QUALITY=""
if [ -n "$CUPS_PRINT_QUALITY" ]; then
    QUALITY="$CUPS_PRINT_QUALITY"
elif [ -n "$PRINT_QUALITY" ]; then
    case "$PRINT_QUALITY" in
        3) QUALITY="Draft"  ;;
        4) QUALITY="Normal" ;;
        5) QUALITY="High"   ;;
    esac
fi

# Quality preset: each level overrides BOTH TonerSave and Resolution. This
# is intentional — single-picker semantics (the user said "I want Draft",
# not "I want Draft toner but 600dpi resolution"). Per-job overrides on
# TonerSave or Resolution that conflict with the picked quality are
# discarded; if you want independent control, drop the Quality option from
# the job (lp -o cupsPrintQuality= or just don't set it).
if [ -n "$QUALITY" ]; then
    case "$QUALITY" in
        Draft)
            TONER_SAVE="ON"
            RESOLUTION="300dpi"
            ;;
        Normal)
            TONER_SAVE="OFF"
            RESOLUTION="600dpi"
            ;;
        High)
            TONER_SAVE="OFF"
            RESOLUTION="1200dpi"   # PPD value for HQ1200 (2400×600)
            ;;
    esac
    log "Quality preset '$QUALITY' applied: toner=$TONER_SAVE resolution=$RESOLUTION"
fi

# Coerce paper size to what's loaded (see LOADED_PAPER above). Avoids the
# printer pausing on a media mismatch when a client (e.g. an iPhone with
# A4 as its AirPrint default) requests something we don't have loaded.
# Envelopes are not coerced — they're a different physical media that
# the user has to load manually anyway.
if [ -n "$LOADED_PAPER" ]; then
    case "$PAGE_SIZE" in
        Letter|Legal|Executive|A4|A5|A6)
            if [ "$PAGE_SIZE" != "$LOADED_PAPER" ]; then
                warn "PageSize=$PAGE_SIZE coerced to $LOADED_PAPER (loaded paper); content rescaled to fit"
                PAGE_SIZE="$LOADED_PAPER"
            fi
            ;;
    esac
fi

log "Resolved: res=$RESOLUTION toner=$TONER_SAVE duplex=$DUPLEX media=$MEDIA_TYPE slot=$INPUT_SLOT paper=$PAGE_SIZE"

#---- Map options to PJL values ----------------------------------------

# Resolution
case "$RESOLUTION" in
    300dpi)  PJL_RES=300  ; GS_RES=300        ;;
    1200dpi) PJL_RES=1200 ; GS_RES=1200       ;;
    *)       PJL_RES=600  ; GS_RES=600        ;;
esac

# Toner save (uppercase via tr to stay bash-3.2 compatible — macOS)
case "$(echo "$TONER_SAVE" | tr '[:lower:]' '[:upper:]')" in
    ON|TRUE|YES) PJL_ECONOOFF="ON"  ;;
    *)           PJL_ECONOOFF="OFF" ;;
esac

# Duplex
case "$DUPLEX" in
    DuplexNoTumble) PJL_DUPLEX="ON";  PJL_BINDING="LONGEDGE"  ;;
    DuplexTumble)   PJL_DUPLEX="ON";  PJL_BINDING="SHORTEDGE" ;;
    *)              PJL_DUPLEX="OFF"; PJL_BINDING="LONGEDGE"   ;;
esac

# Paper size → PJL paper name (LPARM:PCL PAPER) and Ghostscript -sPAPERSIZE
# PJL values per Tech Manual Ch5 §2 (PCL-specific PJL variables, line 1014)
# GS values are the standard Ghostscript paper name lowercase
case "$PAGE_SIZE" in
    Letter)     PJL_PAPER="LETTER"    ; GS_PAPER="letter"    ;;
    Legal)      PJL_PAPER="LEGAL"     ; GS_PAPER="legal"     ;;
    Executive)  PJL_PAPER="EXECUTIVE" ; GS_PAPER="executive" ;;
    A4)         PJL_PAPER="A4"        ; GS_PAPER="a4"        ;;
    A5)         PJL_PAPER="A5"        ; GS_PAPER="a5"        ;;
    A6)         PJL_PAPER="A6"        ; GS_PAPER="a6"        ;;
    Env10)      PJL_PAPER="COM10"     ; GS_PAPER="com10"     ;;
    EnvMonarch) PJL_PAPER="MONARCH"   ; GS_PAPER="monarch"   ;;
    EnvDL)      PJL_PAPER="DL"        ; GS_PAPER="dl"        ;;
    EnvC5)      PJL_PAPER="C5"        ; GS_PAPER="c5"        ;;
    EnvISOB5)   PJL_PAPER="B5"        ; GS_PAPER="isob5"     ;;
    *)          PJL_PAPER="LETTER"    ; GS_PAPER="letter"    ;;
esac

# Input slot → PJL SOURCETRAY (Tech Manual Ch5 §1, line 803)
# HL-5170DN supports: AUTO, MPTRAY, TRAY1, TRAY2 (manual feed not documented;
# MANUALFEED is sent on a best-effort basis)
case "$INPUT_SLOT" in
    MPTRAY) PJL_TRAY="MPTRAY"     ;;
    TRAY1)  PJL_TRAY="TRAY1"      ;;
    TRAY2)  PJL_TRAY="TRAY2"      ;;
    MANUAL) PJL_TRAY="MANUALFEED" ;;
    *)      PJL_TRAY="AUTO"       ;;
esac

# Media type → PJL MEDIATYPE (Tech Manual Ch5 §1, line 727)
# HL-5170DN supports: REGULAR, THICK, THICK2, TRANSPARENCY, THIN, BOND,
# ENVELOPES, ENVTHICK, ENVTHIN
case "$MEDIA_TYPE" in
    THIN)     PJL_MEDIA="THIN"      ;;
    THICK)    PJL_MEDIA="THICK"     ;;
    THICKER)  PJL_MEDIA="THICK2"    ;;
    BOND)     PJL_MEDIA="BOND"      ;;
    ENV)      PJL_MEDIA="ENVELOPES" ;;
    ENVTHICK) PJL_MEDIA="ENVTHICK"  ;;
    ENVTHIN)  PJL_MEDIA="ENVTHIN"   ;;
    *)        PJL_MEDIA="REGULAR"   ;;
esac

#---- Build PJL header -------------------------------------------------
ESC=$'\x1b'
UEL="${ESC}%-12345X"

build_pjl_header() {
    # PJL SET commands persist across the PCL ESC E reset that begins
    # Ghostscript's ljet4 output, so paper/tray/media/copies set here
    # remain in effect for the actual print data.
    printf '%s' "${UEL}"
    printf '@PJL\r\n'
    printf '@PJL SET RESOLUTION=%s\r\n'         "$PJL_RES"
    printf '@PJL SET ECONOMODE=%s\r\n'          "$PJL_ECONOOFF"
    printf '@PJL SET DUPLEX=%s\r\n'             "$PJL_DUPLEX"
    if [ "$PJL_DUPLEX" = "ON" ]; then
        printf '@PJL SET BINDING=%s\r\n'        "$PJL_BINDING"
    fi
    printf '@PJL SET SOURCETRAY=%s\r\n'         "$PJL_TRAY"
    printf '@PJL SET MEDIATYPE=%s\r\n'          "$PJL_MEDIA"
    printf '@PJL SET COPIES=%s\r\n'             "$COPIES"
    printf '@PJL SET LPARM : PCL PAPER=%s\r\n'  "$PJL_PAPER"
    printf '@PJL ENTER LANGUAGE=PCL\r\n'
}

build_pjl_trailer() {
    printf '%s' "${ESC}E"   # PCL reset / eject
    printf '%s' "${UEL}"    # return to PJL
    printf '@PJL\r\n'
    printf '%s' "${UEL}"    # final UEL
}

#---- Determine input type and convert ---------------------------------

# Work in a temp directory (named WORK_DIR to avoid shadowing $TMPDIR)
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

INPUT_PCL="$WORK_DIR/job.pcl"

# Read input to a temp file so we can detect type
if [ -n "$INPUT" ]; then
    INPUT_RAW="$INPUT"
else
    INPUT_RAW="$WORK_DIR/input.raw"
    cat > "$INPUT_RAW"
fi

# Detect MIME type by hex magic bytes (avoids issues with binary ESC in grep)
MAGIC_HEX=$(head -c 4 "$INPUT_RAW" | od -An -tx1 | tr -d ' \n' || true)
FIRST_LINE=$(head -1 "$INPUT_RAW" 2>/dev/null || true)

if echo "$FIRST_LINE" | grep -q "^%!"; then
    INPUT_TYPE="postscript"
elif echo "$FIRST_LINE" | grep -q "^%PDF"; then
    INPUT_TYPE="pdf"
elif echo "$MAGIC_HEX" | grep -q "^52615332"; then
    # 52 61 53 32 = "RaS2" — PWG Raster magic
    INPUT_TYPE="raster"
elif echo "$MAGIC_HEX" | grep -q "^1b"; then
    # ESC (0x1b) at byte 0 = PCL/PJL data
    INPUT_TYPE="pcl"
else
    # Default assumption for unknown: try as PostScript
    INPUT_TYPE="postscript"
fi

log "Detected input type: $INPUT_TYPE"

# Convert to raw PCL 5e using Ghostscript if needed
case "$INPUT_TYPE" in
    postscript|pdf)
        log "Converting $INPUT_TYPE → PCL 5e via Ghostscript (ljet4) at ${GS_RES}dpi paper=$GS_PAPER"
        # -dFIXEDMEDIA: force the device's media size; ignore any
        #   setpagedevice in the input that would override it.
        # -dPDFFitPage: scale PDF content to fit the device's media size.
        # Together these make A4 PDFs print on Letter paper (etc.)
        # without clipping or paper-mismatch pauses.
        gs \
            -dBATCH -dNOPAUSE -dSAFER \
            -sDEVICE=ljet4 \
            -r"${GS_RES}" \
            -sPAPERSIZE="$GS_PAPER" \
            -dFIXEDMEDIA \
            -dPDFFitPage \
            -dNumCopies=1 \
            -sOutputFile="$INPUT_PCL" \
            "$INPUT_RAW" \
            2>&1 | while IFS= read -r line; do log "gs: $line"; done
        # Ghostscript ljet4 output begins with its own ESC E reset and PCL 5e
        # data; our PJL SETs persist across that reset.
        OUTPUT_FILE="$WORK_DIR/final.pcl"
        build_pjl_header > "$OUTPUT_FILE"
        cat "$INPUT_PCL" >> "$OUTPUT_FILE"
        build_pjl_trailer >> "$OUTPUT_FILE"
        cat "$OUTPUT_FILE"
        ;;
    raster)
        # PWG Raster → CUPS Raster → PDF → PCL 5e via cups-filters + Ghostscript
        log "Converting PWG Raster → PCL 5e via cups-filters + Ghostscript (ljet4) at ${GS_RES}dpi paper=$GS_PAPER"
        TMPRAS="$WORK_DIR/input.ras"
        TMPPDF="$WORK_DIR/input.pdf"
        pwgtoraster "$JOB_ID" "$USER" "$TITLE" "$COPIES" "$OPTIONS" "$INPUT_RAW" \
            > "$TMPRAS" || err "pwgtoraster failed; ensure cups-filters is installed"
        rastertopdf "$JOB_ID" "$USER" "$TITLE" "$COPIES" "$OPTIONS" "$TMPRAS" \
            > "$TMPPDF" || err "rastertopdf failed; ensure cups-filters is installed"
        gs \
            -dBATCH -dNOPAUSE -dSAFER \
            -sDEVICE=ljet4 \
            -r"${GS_RES}" \
            -sPAPERSIZE="$GS_PAPER" \
            -dFIXEDMEDIA \
            -dPDFFitPage \
            -dNumCopies=1 \
            -sOutputFile="$INPUT_PCL" \
            "$TMPPDF" \
            2>&1 | while IFS= read -r line; do log "gs: $line"; done
        OUTPUT_FILE="$WORK_DIR/final.pcl"
        build_pjl_header > "$OUTPUT_FILE"
        cat "$INPUT_PCL" >> "$OUTPUT_FILE"
        build_pjl_trailer >> "$OUTPUT_FILE"
        cat "$OUTPUT_FILE"
        ;;
    pcl)
        # Already PCL 5e - just wrap with PJL header
        log "Input is PCL - wrapping with PJL header only"
        build_pjl_header
        cat "$INPUT_RAW"
        build_pjl_trailer
        ;;
    *)
        err "Unknown input type, cannot process job"
        ;;
esac

log "Job $JOB_ID complete"

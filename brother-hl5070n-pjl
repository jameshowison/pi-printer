#!/bin/bash
#
# brother-hl5070n-pjl - CUPS filter for Brother HL-5070N
#
# Prepends a PJL header to control toner save, resolution, duplex,
# media type, and paper source. Converts input (PDF, PostScript, PWG
# Raster) to PCL XL (pxlmono) via Ghostscript if needed.
#
# CUPS calls filters as:
#   filter job-id user title copies options [filename]
#
# Install to: /usr/lib/cups/filter/brother-hl5070n-pjl
# Permissions: chmod 755
#
# Dependencies: ghostscript, cups-filters

set -euo pipefail

#---- CUPS arguments ---------------------------------------------------
JOB_ID="${1:-0}"
USER="${2:-unknown}"
TITLE="${3:-Untitled}"
COPIES="${4:-1}"
OPTIONS="${5:-}"
INPUT="${6:-}"   # empty = read stdin

#---- Logging ----------------------------------------------------------
log() { echo "DEBUG: brother-hl5070n-pjl: $*" >&2; }
err() { echo "ERROR: brother-hl5070n-pjl: $*" >&2; exit 1; }

log "Job $JOB_ID from $USER: '$TITLE' copies=$COPIES"
log "Options: $OPTIONS"

#---- Parse CUPS options -----------------------------------------------
# Helper: extract value for a named option from $OPTIONS
get_opt() {
    local key="$1" default="$2"
    # Match key=value (case-insensitive key)
    local val
    val=$(echo "$OPTIONS" | grep -ioP "(?<=(^| )${key}=)\S+" | head -1 || true)
    echo "${val:-$default}"
}

RESOLUTION=$(get_opt "Resolution" "600dpi")
TONER_SAVE=$(get_opt "TonerSave" "OFF")
DUPLEX=$(get_opt "Duplex" "None")
MEDIA_TYPE=$(get_opt "MediaType" "PLAIN")
INPUT_SLOT=$(get_opt "InputSlot" "AUTO")
PAGE_SIZE=$(get_opt "PageSize" "Letter")

# Also check IPP standard attributes and map them
SIDES=$(get_opt "sides" "")
PRINT_QUALITY=$(get_opt "print-quality" "")

# Map IPP sides → Duplex
if [ -n "$SIDES" ]; then
    case "$SIDES" in
        two-sided-long-edge)  DUPLEX="DuplexNoTumble" ;;
        two-sided-short-edge) DUPLEX="DuplexTumble"   ;;
        one-sided)            DUPLEX="None"            ;;
    esac
fi

# Map IPP print-quality → TonerSave (draft = save on)
if [ -n "$PRINT_QUALITY" ]; then
    case "$PRINT_QUALITY" in
        3) TONER_SAVE="ON"  ;;   # Draft
        4) TONER_SAVE="OFF" ;;   # Normal
        5) TONER_SAVE="OFF" ;;   # High
    esac
fi

log "Resolved: res=$RESOLUTION toner=$TONER_SAVE duplex=$DUPLEX media=$MEDIA_TYPE slot=$INPUT_SLOT"

#---- Map options to PJL values ----------------------------------------

# Resolution
case "$RESOLUTION" in
    300dpi)  PJL_RES=300  ; GS_RES=300        ;;
    1200dpi) PJL_RES=1200 ; GS_RES="1200x600" ;;
    *)       PJL_RES=600  ; GS_RES=600        ;;
esac

# Toner save
case "${TONER_SAVE^^}" in
    ON|TRUE|YES) PJL_ECONOOFF="ON"  ;;
    *)           PJL_ECONOOFF="OFF" ;;
esac

# Duplex
case "$DUPLEX" in
    DuplexNoTumble) PJL_DUPLEX="ON";  PJL_BINDING="LONGEDGE"  ;;
    DuplexTumble)   PJL_DUPLEX="ON";  PJL_BINDING="SHORTEDGE" ;;
    *)              PJL_DUPLEX="OFF"; PJL_BINDING="LONGEDGE"   ;;
esac

# Paper size → PJL paper name
case "$PAGE_SIZE" in
    Letter)     PJL_PAPER="LETTER"     ;;
    Legal)      PJL_PAPER="LEGAL"      ;;
    Executive)  PJL_PAPER="EXECUTIVE"  ;;
    A4)         PJL_PAPER="A4"         ;;
    A5)         PJL_PAPER="A5"         ;;
    A6)         PJL_PAPER="A6"         ;;
    Env10)      PJL_PAPER="COM10"      ;;
    EnvMonarch) PJL_PAPER="MONARCH"    ;;
    EnvDL)      PJL_PAPER="DL"         ;;
    EnvC5)      PJL_PAPER="C5"         ;;
    EnvISOB5)   PJL_PAPER="B5ENVELOPE" ;;
    *)          PJL_PAPER="LETTER"     ;;
esac

# Input slot → PJL tray name
case "$INPUT_SLOT" in
    MPTRAY) PJL_TRAY="MPTRAY"     ;;
    TRAY1)  PJL_TRAY="TRAY1"      ;;
    TRAY2)  PJL_TRAY="TRAY2"      ;;
    MANUAL) PJL_TRAY="MANUALFEED" ;;
    *)      PJL_TRAY="AUTOSELECT" ;;
esac

# Media type → PJL media type name
case "$MEDIA_TYPE" in
    THIN)     PJL_MEDIA="THIN"     ;;
    THICK)    PJL_MEDIA="THICK"    ;;
    THICKER)  PJL_MEDIA="THICKER"  ;;
    BOND)     PJL_MEDIA="BOND"     ;;
    ENV)      PJL_MEDIA="ENVELOPE" ;;
    ENVTHICK) PJL_MEDIA="ENVTHICK" ;;
    ENVTHIN)  PJL_MEDIA="ENVTHIN"  ;;
    *)        PJL_MEDIA="PLAIN"    ;;
esac

#---- Build PJL header -------------------------------------------------
ESC=$'\x1b'
UEL="${ESC}%-12345X"

build_pjl_header() {
    printf '%s' "${UEL}"
    printf '@PJL\r\n'
    printf '@PJL SET RESOLUTION=%s\r\n'  "$PJL_RES"
    printf '@PJL SET ECONOMODE=%s\r\n'   "$PJL_ECONOOFF"
    printf '@PJL SET DUPLEX=%s\r\n'      "$PJL_DUPLEX"
    if [ "$PJL_DUPLEX" = "ON" ]; then
        printf '@PJL SET BINDING=%s\r\n' "$PJL_BINDING"
    fi
    printf '@PJL SET PAPER=%s\r\n'      "$PJL_PAPER"
    printf '@PJL SET SOURCETRAY=%s\r\n' "$PJL_TRAY"
    printf '@PJL SET MEDIATYPE=%s\r\n'  "$PJL_MEDIA"
    printf '@PJL SET COPIES=%s\r\n'     "$COPIES"
    # PCL XL data that follows provides its own @PJL ENTER LANGUAGE=PCLXL
}

build_pjl_trailer() {
    printf '%s' "${UEL}"   # return to PJL
    printf '@PJL\r\n'
    printf '%s' "${UEL}"   # final UEL
}

#---- Determine input type and convert ---------------------------------

# Work in a temp directory (named WORK_DIR to avoid shadowing $TMPDIR)
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

INPUT_PCL="$WORK_DIR/job.pcl"

# Read input to a temp file so we can detect type
if [ -n "$INPUT" ]; then
    INPUT_RAW="$INPUT"
else
    INPUT_RAW="$WORK_DIR/input.raw"
    cat > "$INPUT_RAW"
fi

# Detect MIME type by hex magic bytes (avoids issues with binary ESC in grep)
MAGIC_HEX=$(head -c 4 "$INPUT_RAW" | od -An -tx1 | tr -d ' \n' || true)
FIRST_LINE=$(head -1 "$INPUT_RAW" 2>/dev/null || true)

if echo "$FIRST_LINE" | grep -q "^%!"; then
    INPUT_TYPE="postscript"
elif echo "$FIRST_LINE" | grep -q "^%PDF"; then
    INPUT_TYPE="pdf"
elif echo "$MAGIC_HEX" | grep -q "^52615332"; then
    # 52 61 53 32 = "RaS2" — PWG Raster magic
    INPUT_TYPE="raster"
elif echo "$MAGIC_HEX" | grep -q "^1b"; then
    # ESC (0x1b) at byte 0 = PCL/PJL data
    INPUT_TYPE="pcl"
else
    # Default assumption for unknown: try as PostScript
    INPUT_TYPE="postscript"
fi

log "Detected input type: $INPUT_TYPE"

# Convert to raw PCL XL raster using Ghostscript if needed
case "$INPUT_TYPE" in
    postscript|pdf)
        log "Converting $INPUT_TYPE → PCL via Ghostscript (pxlmono) at ${GS_RES}dpi"
        gs \
            -dBATCH -dNOPAUSE -dSAFER \
            -sDEVICE=pxlmono \
            -r"${GS_RES}" \
            -dNumCopies=1 \
            -sOutputFile="$INPUT_PCL" \
            "$INPUT_RAW" \
            2>&1 | while IFS= read -r line; do log "gs: $line"; done
        # Ghostscript pxlmono output starts with its own UEL + @PJL ENTER LANGUAGE=PCLXL,
        # so our SET commands precede it correctly after the opening UEL.
        OUTPUT_FILE="$WORK_DIR/final.pcl"
        build_pjl_header > "$OUTPUT_FILE"
        cat "$INPUT_PCL" >> "$OUTPUT_FILE"
        build_pjl_trailer >> "$OUTPUT_FILE"
        cat "$OUTPUT_FILE"
        ;;
    raster)
        # PWG Raster → CUPS Raster → PDF → PCL XL via cups-filters + Ghostscript
        log "Converting PWG Raster → PCL via cups-filters + Ghostscript at ${GS_RES}dpi"
        TMPRAS="$WORK_DIR/input.ras"
        TMPPDF="$WORK_DIR/input.pdf"
        pwgtoraster "$JOB_ID" "$USER" "$TITLE" "$COPIES" "$OPTIONS" "$INPUT_RAW" \
            > "$TMPRAS" || err "pwgtoraster failed; ensure cups-filters is installed"
        rastertopdf "$JOB_ID" "$USER" "$TITLE" "$COPIES" "$OPTIONS" "$TMPRAS" \
            > "$TMPPDF" || err "rastertopdf failed; ensure cups-filters is installed"
        gs \
            -dBATCH -dNOPAUSE -dSAFER \
            -sDEVICE=pxlmono \
            -r"${GS_RES}" \
            -dNumCopies=1 \
            -sOutputFile="$INPUT_PCL" \
            "$TMPPDF" \
            2>&1 | while IFS= read -r line; do log "gs: $line"; done
        OUTPUT_FILE="$WORK_DIR/final.pcl"
        build_pjl_header > "$OUTPUT_FILE"
        cat "$INPUT_PCL" >> "$OUTPUT_FILE"
        build_pjl_trailer >> "$OUTPUT_FILE"
        cat "$OUTPUT_FILE"
        ;;
    pcl)
        # Already PCL XL - just wrap with PJL header
        log "Input is PCL - wrapping with PJL header only"
        build_pjl_header
        cat "$INPUT_RAW"
        build_pjl_trailer
        ;;
    *)
        err "Unknown input type, cannot process job"
        ;;
esac

log "Job $JOB_ID complete"

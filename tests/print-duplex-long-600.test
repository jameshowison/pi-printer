# Two-sided long-edge (book), 600 dpi
# Usage: ipptool -tv -f FILE -d filetype=application/pdf ipp://localhost:PORT/ipp/print print-duplex-long-600.test
{
	NAME "Print-Job duplex long-edge 600dpi"
	OPERATION Print-Job

	GROUP operation-attributes-tag
	ATTR charset attributes-charset utf-8
	ATTR language attributes-natural-language en
	ATTR uri printer-uri $uri
	ATTR name requesting-user-name $user
	ATTR mimeMediaType document-format $filetype

	GROUP job-attributes-tag
	ATTR integer copies 1
	ATTR keyword sides two-sided-long-edge
	ATTR resolution printer-resolution 600dpi

	FILE $filename

	STATUS successful-ok
	STATUS successful-ok-ignored-or-substituted-attributes

	EXPECT job-id
	EXPECT job-uri
}

# Chart test page — simplex, 150 dpi direct (no APT — quality=4 to avoid Mode 1024)
# Usage: ipptool -tv -f /home/tuttle/pi-printer/chart-test.pdf -d filetype=application/pdf ipp://localhost:PORT/ipp/print print-chart-simplex-150.test
{
	NAME "Print-Job chart simplex 150dpi direct"
	OPERATION Print-Job

	GROUP operation-attributes-tag
	ATTR charset attributes-charset utf-8
	ATTR language attributes-natural-language en
	ATTR uri printer-uri $uri
	ATTR name requesting-user-name $user
	ATTR mimeMediaType document-format $filetype

	GROUP job-attributes-tag
	ATTR integer copies 1
	ATTR keyword sides one-sided
	ATTR resolution printer-resolution 150dpi
	ATTR enum print-quality 4

	FILE $filename

	STATUS successful-ok
	STATUS successful-ok-ignored-or-substituted-attributes

	EXPECT job-id
	EXPECT job-uri
}
